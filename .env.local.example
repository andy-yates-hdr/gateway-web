# Markdown content source. REQUIRED once MarkdownContentSource is turned on —
# there is no default. With the flag off (its default), this can stay unset;
# nothing reads it. Either a local filesystem path to the content directory
# (e.g. the sibling cms_spike/content checkout), or a GitHub Contents API URL
# (e.g.
# https://api.github.com/repos/HDRUK/techspike-wordpress-replacement/contents/content?ref=main)
# to read from GitHub instead; set the token below if that repo is private.
MARKDOWN_CONTENT_ROOT=
MARKDOWN_CONTENT_GITHUB_TOKEN=

# GitHub-mode caching only (no effect in local mode). How long a fetched
# value is served without any network call at all; defaults to 300s if
# unset. Set to 0 to disable caching outright.
MARKDOWN_CONTENT_CACHE_TTL_SECONDS=
# Once the TTL has expired, whether to revalidate via a conditional request
# (If-None-Match) before re-fetching, reusing the cached value on a 304
# rather than re-downloading unchanged content. Off by default.
# Set to true to turn on
MARKDOWN_CONTENT_ETAG_CHECK=